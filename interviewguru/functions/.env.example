# Bu dosya ŞABLONDUR (commit edilir). Gerçek değerler buraya YAZILMAZ.
#
# 1) SIR OLMAYAN yapılandırma  →  functions/.env
OPENAI_MODEL=gpt-4o-mini
ONESIGNAL_APP_ID=<istemcide de bulunan OneSignal uygulama kimliği — sır değil>
# ONESIGNAL_SMALL_ICON=ic_stat_onesignal_default
# App Check konsolda iki uygulama için kaydedilince true yap:
ENFORCE_APP_CHECK=false
#
# 2) SIRLAR  →  Secret Manager (koda defineSecret ile bağlı)
#      firebase functions:secrets:set OPENAI_API_KEY
#      firebase functions:secrets:set REVENUECAT_WEBHOOK_AUTH
#      firebase functions:secrets:set ONESIGNAL_API_KEY
#    Emülatör için aynı anahtarları functions/.env.local'a yaz; o dosya deploy edilmez.
