rules_version = '2';

// InterviewGuru Firestore kuralları.
// İlke: kullanıcı yalnız KENDİ dokümanını okur/yazar; kredi, premium ve sayaç
// alanları yalnız sunucunun (Admin SDK / Functions) yazabildiği alanlardır.
// LearnInvest'teki `allow list` sızıntısı burada yok: users koleksiyonu listelenemez.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/userRoles/$(request.auth.uid))
        && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.isAdmin == true;
    }

    // Sunucuya ait alanlar — istemci ne oluşturabilir ne değiştirebilir.
    function serverKeys() {
      return ['aiCredits', 'isPremium', 'subscriptionStatus', 'subscriptionProductId',
              'subscriptionStore', 'subscriptionExpirationDate', 'welcomeGranted',
              'aiUsage', 'adRewards', 'questionSets', 'isAdmin', 'role'];
    }
    function noServerKeysOnCreate() {
      return !request.resource.data.keys().hasAny(serverKeys());
    }
    function serverKeysUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverKeys());
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create: if isOwner(uid) && noServerKeysOnCreate();
      allow update: if isOwner(uid) && serverKeysUnchanged();
      allow delete: if false; // silme deleteMyData fonksiyonuyla

      // Sunucunun yazdığı geçmiş: kullanıcı okur ve silebilir, yazamaz.
      match /cvReviews/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if false;
      }
      match /interviews/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if false;
      }

      // Kullanıcının kendi verisi.
      match /cvs/{id} {
        allow read, write: if isOwner(uid);
      }
      match /quizResults/{id} {
        allow read, create: if isOwner(uid);
        allow update, delete: if false;
      }
    }

    // İçerik (dile göre). Okuma herkese (anonim oturum dahil), yazma admin.
    match /lessons/{lang}/items/{lessonId} {
      allow read: if true;
      allow write: if isAdmin();
      match /topics/{topicId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }
    match /salaries/{lang}/items/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /countries/{lang}/items/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /tips/{lang}/items/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Yalnız sunucu.
    match /userRoles/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
    match /device_credits/{id} { allow read, write: if false; }
    match /rateLimits/{id} { allow read, write: if false; }
    match /processedRevenueCatEvents/{id} { allow read, write: if false; }

    // Varsayılan: kapalı.
    match /{document=**} { allow read, write: if false; }
  }
}
